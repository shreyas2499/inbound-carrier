# --- Legacy TMS (raw TCP socket) ---
TMS_HOST=
TMS_PORT=
TMS_AUTH_TOKEN=

# --- FMCSA authority lookup (public REST) ---
FMCSA_API_KEY=

# --- This adapter service ---
ADAPTER_API_KEY=            # every adapter endpoint requires this
TMS_CLIENT_TIMEOUT_SECONDS=8   # must stay well under the TMS 30s idle timeout
TMS_MAX_RETRIES=2              # bounded retries on fresh connections

# --- HappyRobot Twin (managed Postgres via REST) ---
# OPTIONAL. Leave HAPPYROBOT_API_KEY blank and all Twin logging is a silent no-op,
# so the adapter runs fine without it. Fill it in when you're ready to turn
# event_log / carriers logging on.
HAPPYROBOT_API_KEY=                                        # Bearer token (Platform API key)
HAPPYROBOT_API_BASE=https://platform.happyrobot.ai/api/v2  # fixed; override only if told to
TWIN_TIMEOUT_SECONDS=6                                     # short — logging must never stall a call
