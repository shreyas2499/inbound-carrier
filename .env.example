# --- Legacy TMS (raw TCP socket) ---
TMS_HOST=
TMS_PORT=
TMS_AUTH_TOKEN=

# --- FMCSA authority lookup (public REST) ---
FMCSA_API_KEY=

# --- This adapter service ---
ADAPTER_API_KEY=            # every adapter endpoint requires this
TMS_CLIENT_TIMEOUT_SECONDS=8   # must stay well under the TMS 30s idle timeout
TMS_MAX_RETRIES=2              # bounded retries on fresh connections
